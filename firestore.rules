rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidListing() {
      return request.resource.data.keys().hasAll(['title', 'price', 'seller_id']) 
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for seller info display and username checks)
      allow read: if true;
      
      // Users can only manage their own profile
      allow create, update, delete: if isOwner(userId);
    }
    
    // Listings collection
    match /listings/{listingId} {
      allow read: if true;
      
      // Users can create their own listings
      allow create: if isAuthenticated() && request.resource.data.seller_id == request.auth.uid;
      
      // Sellers can update/delete their own listings
      // Anyone authenticated can update ONLY the likes count
      allow update: if isAuthenticated() && 
        (resource.data.seller_id == request.auth.uid || 
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && 
          request.resource.data.keys().hasAll(resource.data.keys())));
      
      allow delete: if isAuthenticated() && resource.data.seller_id == request.auth.uid;
      
      // Comments subcollection
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        
        // Authenticated users can create comments
        allow create: if isAuthenticated();
        
        // Users can update their own comments
        allow update: if isAuthenticated() 
          && resource.data.user_id == request.auth.uid;
        
        // Users can delete their own comments, or listing owner can delete any comment
        allow delete: if isAuthenticated() 
          && (resource.data.user_id == request.auth.uid || 
              get(/databases/$(database)/documents/listings/$(listingId)).data.seller_id == request.auth.uid);
      }
    }
    
    // Likes collection
    match /likes/{likeId} {
      // Anyone authenticated can read likes
      allow read: if isAuthenticated();
      
      // Users can only create likes for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Users can only delete their own likes
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Likes cannot be updated
      allow update: if false;
    }
    
    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      // Anyone authenticated can read bookmarks
      allow read: if isAuthenticated();
      
      // Users can only create bookmarks for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Users can only delete their own bookmarks
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Bookmarks cannot be updated
      allow update: if false;
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Only chat participants can read/write
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Authenticated users can create chats if they are participants
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants;
      
      // Only participants can update chat (for lastMessage updates and soft deletes)
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Only allow deletion if both participants have soft-deleted (indicated by deletedFor array length)
      allow delete: if isAuthenticated() 
        && request.auth.uid in resource.data.participants
        && resource.data.deletedFor.size() >= 2;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read messages
        allow read: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Only chat participants can send messages
        allow create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        
        // Allow participants to delete their own messages or any message in the chat
        allow delete: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Messages cannot be updated
        allow update: if false;
      }
    }
    
    // Blocks collection
    match /blocks/{blockId} {
      // Users can read blocks where they are the blocker
      allow read: if isAuthenticated() 
        && resource.data.blocker_id == request.auth.uid;
      
      // Users can create blocks for themselves (where they are the blocker)
      allow create: if isAuthenticated() 
        && request.resource.data.blocker_id == request.auth.uid
        && request.resource.data.blocked_id != request.auth.uid;
      
      // Users can delete their own blocks
      allow delete: if isAuthenticated() 
        && resource.data.blocker_id == request.auth.uid;
      
      // Blocks cannot be updated
      allow update: if false;
    }
    
    // Favorites collection
    match /favorites/{favoriteId} {
      // Anyone authenticated can read favorites
      allow read: if isAuthenticated();
      
      // Users can create favorites for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.user_id == request.auth.uid;
      
      // Users can delete their own favorites
      allow delete: if isAuthenticated() 
        && resource.data.user_id == request.auth.uid;
      
      // Favorites cannot be updated
      allow update: if false;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() 
        && resource.data.recipient_id == request.auth.uid;
      
      // Anyone can create notifications (for sending notifications to others)
      allow create: if isAuthenticated();
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() 
        && resource.data.recipient_id == request.auth.uid;
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() 
        && resource.data.recipient_id == request.auth.uid;
    }
    
    // Ratings collection
    match /ratings/{ratingId} {
      // Anyone can read ratings (for displaying seller ratings)
      allow read: if true;
      
      // Users can create ratings for others (not themselves)
      allow create: if isAuthenticated() 
        && request.resource.data.rater_id == request.auth.uid
        && request.resource.data.seller_id != request.auth.uid;
      
      // Users can update their own ratings
      allow update: if isAuthenticated() 
        && resource.data.rater_id == request.auth.uid;
      
      // Users can delete their own ratings
      allow delete: if isAuthenticated() 
        && resource.data.rater_id == request.auth.uid;
    }
  }
}
