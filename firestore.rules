rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isListingOwner(listingId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/listings/$(listingId)).data.seller_id == request.auth.uid;
    }
    
    function isValidListing() {
      return request.resource.data.keys().hasAll(['title', 'price', 'seller_id']) 
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }

    function isCanonicalNotification() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'recipient_id', 'sender_id', 'sender_name', 'sender_profile_image',
          'type', 'title', 'body', 'related_listing_id', 'related_user_id',
          'is_read', 'created_at', 'additional_data'
        ])
        && data.recipient_id is string
        && data.recipient_id != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(data.recipient_id))
        && data.sender_id == request.auth.uid
        && data.sender_name is string
        && data.sender_name.size() > 0
        && data.sender_name.size() <= 160
        && (data.sender_profile_image == null || data.sender_profile_image is string)
        && data.type in [
          'like', 'comment', 'share', 'message', 'follow', 'new_listing', 'rating',
          'offer', 'transaction'
        ]
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.body is string
        && data.body.size() <= 1000
        && (data.related_listing_id == null || data.related_listing_id is string)
        && data.related_user_id == request.auth.uid
        && data.is_read == false
        && data.created_at == request.time
        && data.additional_data is map;
    }

    function hasValidNotificationSource() {
      let data = request.resource.data;
      return
        (data.type == 'follow'
          && exists(/databases/$(database)/documents/favorites/$(request.auth.uid + '_' + data.recipient_id)))
        ||
        (data.type == 'new_listing'
          && data.related_listing_id is string
          && exists(/databases/$(database)/documents/listings/$(data.related_listing_id))
          && get(/databases/$(database)/documents/listings/$(data.related_listing_id)).data.seller_id == request.auth.uid
          && exists(/databases/$(database)/documents/favorites/$(data.recipient_id + '_' + request.auth.uid)))
        ||
        (data.type == 'like'
          && data.related_listing_id is string
          && exists(/databases/$(database)/documents/listings/$(data.related_listing_id))
          && get(/databases/$(database)/documents/listings/$(data.related_listing_id)).data.seller_id == data.recipient_id
          && exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + data.related_listing_id)))
        ||
        (data.type == 'share'
          && data.related_listing_id is string
          && data.additional_data.share_id is string
          && exists(/databases/$(database)/documents/listing_shares/$(data.additional_data.share_id))
          && get(/databases/$(database)/documents/listing_shares/$(data.additional_data.share_id)).data.shared_by == request.auth.uid
          && get(/databases/$(database)/documents/listing_shares/$(data.additional_data.share_id)).data.listing_id == data.related_listing_id
          && get(/databases/$(database)/documents/listings/$(data.related_listing_id)).data.seller_id == data.recipient_id)
        ||
        (data.type == 'comment'
          && data.related_listing_id is string
          && data.additional_data.comment_id is string
          && exists(/databases/$(database)/documents/listings/$(data.related_listing_id)/comments/$(data.additional_data.comment_id))
          && get(/databases/$(database)/documents/listings/$(data.related_listing_id)/comments/$(data.additional_data.comment_id)).data.user_id == request.auth.uid
          && get(/databases/$(database)/documents/listings/$(data.related_listing_id)).data.seller_id == data.recipient_id)
        ||
        (data.type == 'rating'
          && data.related_listing_id is string
          && data.additional_data.rating_id is string
          && data.additional_data.transaction_id is string
          && exists(/databases/$(database)/documents/users/$(data.recipient_id)/ratings/$(data.additional_data.rating_id))
          && get(/databases/$(database)/documents/users/$(data.recipient_id)/ratings/$(data.additional_data.rating_id)).data.reviewer_id == request.auth.uid
          && get(/databases/$(database)/documents/users/$(data.recipient_id)/ratings/$(data.additional_data.rating_id)).data.reviewee_id == data.recipient_id
          && get(/databases/$(database)/documents/users/$(data.recipient_id)/ratings/$(data.additional_data.rating_id)).data.transaction_id == data.additional_data.transaction_id
          && get(/databases/$(database)/documents/users/$(data.recipient_id)/ratings/$(data.additional_data.rating_id)).data.listing_id == data.related_listing_id
          && exists(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id))
          && get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.status == 'completed')
        ||
        (data.type == 'offer'
          && data.related_listing_id is string
          && data.additional_data.offer_id is string
          && data.additional_data.offer_status is string
          && exists(/databases/$(database)/documents/offers/$(data.additional_data.offer_id))
          && get(/databases/$(database)/documents/offers/$(data.additional_data.offer_id)).data.listing_id == data.related_listing_id
          && get(/databases/$(database)/documents/offers/$(data.additional_data.offer_id)).data.status == data.additional_data.offer_status
          && get(/databases/$(database)/documents/offers/$(data.additional_data.offer_id)).data.last_action_by == request.auth.uid
          && ((get(/databases/$(database)/documents/offers/$(data.additional_data.offer_id)).data.buyer_id == request.auth.uid
                && get(/databases/$(database)/documents/offers/$(data.additional_data.offer_id)).data.seller_id == data.recipient_id)
              || (get(/databases/$(database)/documents/offers/$(data.additional_data.offer_id)).data.seller_id == request.auth.uid
                && get(/databases/$(database)/documents/offers/$(data.additional_data.offer_id)).data.buyer_id == data.recipient_id)))
        ||
        (data.type == 'transaction'
          && data.related_listing_id is string
          && data.additional_data.transaction_id is string
          && data.additional_data.transaction_status is string
          && data.additional_data.chat_id is string
          && data.additional_data.confirmed_role in ['buyer', 'seller']
          && exists(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id))
          && get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.listing_id == data.related_listing_id
          && get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.chat_id == data.additional_data.chat_id
          && get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.status == data.additional_data.transaction_status
          && get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.last_action_by == request.auth.uid
          && ((get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.buyer_id == request.auth.uid
                && data.additional_data.confirmed_role == 'buyer'
                && get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.seller_id == data.recipient_id)
              || (get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.seller_id == request.auth.uid
                && data.additional_data.confirmed_role == 'seller'
                && get(/databases/$(database)/documents/transactions/$(data.additional_data.transaction_id)).data.buyer_id == data.recipient_id)))
        ||
        (data.type == 'message'
          && data.additional_data.chat_id is string
          && exists(/databases/$(database)/documents/chats/$(data.additional_data.chat_id))
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(data.additional_data.chat_id)).data.participants
          && data.recipient_id in get(/databases/$(database)/documents/chats/$(data.additional_data.chat_id)).data.participants);
    }
    
    // Username reservations provide race-safe, case-normalized uniqueness.
    match /usernames/{username} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;

      allow delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for seller info display and username checks)
      allow read: if true;
      
      // Users can only manage their own profile.
      allow create, update, delete: if isOwner(userId);
      
      // Verified transaction reviews. A participant may leave one review for
      // the other participant per completed transaction. The deterministic
      // document ID prevents duplicate reviews for the same side/deal.
      match /ratings/{ratingId} {
        allow read: if true;

        allow create: if isAuthenticated()
          && request.auth.uid != userId
          && exists(/databases/$(database)/documents/users/$(userId))
          && request.resource.data.keys().hasOnly([
            'transaction_id', 'listing_id', 'listing_title', 'reviewer_id',
            'reviewee_id', 'reviewer_role', 'reviewee_role', 'rating', 'review',
            'created_at', 'updated_at'
          ])
          && request.resource.data.transaction_id is string
          && ratingId == request.resource.data.transaction_id + '_' + request.auth.uid
          && request.resource.data.reviewer_id == request.auth.uid
          && request.resource.data.reviewee_id == userId
          && request.resource.data.reviewer_role in ['buyer', 'seller']
          && request.resource.data.reviewee_role in ['buyer', 'seller']
          && request.resource.data.reviewer_role != request.resource.data.reviewee_role
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.review is string
          && request.resource.data.review.size() <= 1000
          && request.resource.data.created_at == request.time
          && request.resource.data.updated_at == request.time
          && exists(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id))
          && get(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id)).data.status == 'completed'
          && get(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id)).data.listing_id == request.resource.data.listing_id
          && get(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id)).data.listing_title == request.resource.data.listing_title
          && ((get(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id)).data.buyer_id == request.auth.uid
                && get(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id)).data.seller_id == userId
                && request.resource.data.reviewer_role == 'buyer'
                && request.resource.data.reviewee_role == 'seller')
              || (get(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id)).data.seller_id == request.auth.uid
                && get(/databases/$(database)/documents/transactions/$(request.resource.data.transaction_id)).data.buyer_id == userId
                && request.resource.data.reviewer_role == 'seller'
                && request.resource.data.reviewee_role == 'buyer'));

        allow update: if isAuthenticated()
          && resource.data.reviewer_id == request.auth.uid
          && resource.data.reviewee_id == userId
          && ratingId == resource.data.transaction_id + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly([
            'transaction_id', 'listing_id', 'listing_title', 'reviewer_id',
            'reviewee_id', 'reviewer_role', 'reviewee_role', 'rating', 'review',
            'created_at', 'updated_at'
          ])
          && request.resource.data.transaction_id == resource.data.transaction_id
          && request.resource.data.listing_id == resource.data.listing_id
          && request.resource.data.listing_title == resource.data.listing_title
          && request.resource.data.reviewer_id == resource.data.reviewer_id
          && request.resource.data.reviewee_id == resource.data.reviewee_id
          && request.resource.data.reviewer_role == resource.data.reviewer_role
          && request.resource.data.reviewee_role == resource.data.reviewee_role
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.updated_at == request.time
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.review is string
          && request.resource.data.review.size() <= 1000
          && exists(/databases/$(database)/documents/transactions/$(resource.data.transaction_id))
          && get(/databases/$(database)/documents/transactions/$(resource.data.transaction_id)).data.status == 'completed';

        allow delete: if isAuthenticated()
          && resource.data.reviewer_id == request.auth.uid
          && ((resource.data.keys().hasAll(['transaction_id', 'reviewee_id'])
                && resource.data.reviewee_id == userId
                && ratingId == resource.data.transaction_id + '_' + request.auth.uid)
              || (!resource.data.keys().hasAny(['transaction_id'])
                && ratingId == request.auth.uid));
      }
    }
    
    // Followers collection
    match /followers/{followId} {
      // Anyone authenticated can read followers
      allow read: if isAuthenticated();
      
      // Users can only create follow relationships where they are the follower
      allow create: if isAuthenticated() 
        && request.resource.data.follower_id == request.auth.uid;
      
      // Users can only delete their own follow relationships
      allow delete: if isAuthenticated() 
        && resource.data.follower_id == request.auth.uid;
      
      // Follow relationships cannot be updated
      allow update: if false;
    }
    
    // Listings collection
    match /listings/{listingId} {
      allow read: if true;
      
      // Users can create listings
      allow create: if isAuthenticated() 
                    && isValidListing()
                    && request.resource.data.seller_id == request.auth.uid
                    && request.resource.data.status == 'active'
                    && !request.resource.data.keys().hasAny([
                      'reserved_for_user_id', 'reserved_offer_id', 'reserved_at',
                      'sold_transaction_id', 'sold_at'
                    ]);
      
      // Sellers can edit ordinary listing fields. Reservation and transaction
      // lifecycle fields are separately constrained so a reserved item cannot
      // be marked sold without both participants completing its transaction.
      allow update: if isAuthenticated()
        && ((resource.data.seller_id == request.auth.uid
              && request.resource.data.seller_id == resource.data.seller_id
              && request.resource.data.status in ['active', 'reserved', 'sold']
              && (request.resource.data.status == resource.data.status
                || (resource.data.status == 'active'
                  && request.resource.data.status in ['reserved', 'sold'])
                || (resource.data.status == 'reserved'
                  && request.resource.data.status == 'active'))
              && ((resource.data.keys().hasAll(['sold_transaction_id', 'sold_at'])
                  && request.resource.data.sold_transaction_id == resource.data.sold_transaction_id
                  && request.resource.data.sold_at == resource.data.sold_at)
                || (!resource.data.keys().hasAny(['sold_transaction_id', 'sold_at'])
                  && !request.resource.data.keys().hasAny([
                    'sold_transaction_id', 'sold_at'
                  ])))
              && (request.resource.data.status != 'active'
                || !request.resource.data.keys().hasAny([
                  'reserved_for_user_id', 'reserved_offer_id', 'reserved_at'
                ]))
              && (!(resource.data.status == 'reserved'
                    && request.resource.data.status == 'active')
                || (resource.data.reserved_offer_id is string
                  && existsAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id))
                  && getAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id)).data.status == 'cancelled'
                  && getAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id)).data.last_action_by == request.auth.uid
                  && (!exists(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id))
                    || (existsAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id))
                      && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.status == 'cancelled'
                      && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.last_action_by == request.auth.uid))))
              && (request.resource.data.status != 'reserved'
                || (resource.data.status == 'reserved'
                  && request.resource.data.reserved_for_user_id == resource.data.reserved_for_user_id
                  && request.resource.data.reserved_offer_id == resource.data.reserved_offer_id
                  && request.resource.data.reserved_at == resource.data.reserved_at)
                || (resource.data.status == 'active'
                  && request.resource.data.reserved_for_user_id is string
                  && request.resource.data.reserved_offer_id is string
                  && request.resource.data.reserved_at == request.time
                  && existsAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id))
                  && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.status == 'accepted'
                  && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.listing_id == listingId
                  && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.seller_id == request.auth.uid
                  && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.buyer_id == request.resource.data.reserved_for_user_id
                  && existsAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id))
                  && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.status == 'reserved'
                  && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.listing_id == listingId
                  && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.seller_id == request.auth.uid
                  && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.buyer_id == request.resource.data.reserved_for_user_id))
              && (request.resource.data.status != 'sold'
                || (resource.data.status != 'reserved'
                  && !request.resource.data.keys().hasAny([
                    'reserved_for_user_id', 'reserved_offer_id', 'reserved_at'
                  ]))))
          || (resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reserved_for_user_id', 'reserved_offer_id',
              'reserved_at', 'updated_at'
            ])
            && request.resource.data.status == 'reserved'
            && request.resource.data.reserved_for_user_id == request.auth.uid
            && request.resource.data.reserved_offer_id is string
            && request.resource.data.reserved_at == request.time
            && request.resource.data.updated_at == request.time
            && existsAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id))
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.last_action_by == request.auth.uid
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.listing_id == listingId
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.seller_id == resource.data.seller_id
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.reserved_offer_id)).data.buyer_id == request.auth.uid
            && existsAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id))
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.status == 'reserved'
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.listing_id == listingId
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.seller_id == resource.data.seller_id
            && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.reserved_offer_id)).data.buyer_id == request.auth.uid)
          || (resource.data.status == 'reserved'
            && resource.data.reserved_for_user_id == request.auth.uid
            && resource.data.reserved_offer_id is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reserved_for_user_id', 'reserved_offer_id',
              'reserved_at', 'updated_at'
            ])
            && request.resource.data.status == 'active'
            && request.resource.data.updated_at == request.time
            && !request.resource.data.keys().hasAny([
              'reserved_for_user_id', 'reserved_offer_id', 'reserved_at'
            ])
            && existsAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id))
            && getAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id)).data.status == 'cancelled'
            && getAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id)).data.last_action_by == request.auth.uid
            && getAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id)).data.listing_id == listingId
            && getAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id)).data.seller_id == resource.data.seller_id
            && getAfter(/databases/$(database)/documents/offers/$(resource.data.reserved_offer_id)).data.buyer_id == request.auth.uid
            && (!exists(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id))
              || (existsAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id))
                && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.status == 'cancelled'
                && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.last_action_by == request.auth.uid)))
          || (resource.data.status == 'reserved'
            && resource.data.reserved_offer_id is string
            && resource.data.reserved_for_user_id is string
            && request.auth.uid in [
              resource.data.seller_id, resource.data.reserved_for_user_id
            ]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reserved_for_user_id', 'reserved_offer_id',
              'reserved_at', 'sold_transaction_id', 'sold_at', 'updated_at'
            ])
            && request.resource.data.status == 'sold'
            && request.resource.data.sold_transaction_id == resource.data.reserved_offer_id
            && request.resource.data.sold_at == request.time
            && request.resource.data.updated_at == request.time
            && !request.resource.data.keys().hasAny([
              'reserved_for_user_id', 'reserved_offer_id', 'reserved_at'
            ])
            && exists(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id))
            && get(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.status == 'reserved'
            && existsAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id))
            && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.status == 'completed'
            && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.last_action_by == request.auth.uid
            && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.listing_id == listingId
            && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.seller_id == resource.data.seller_id
            && getAfter(/databases/$(database)/documents/transactions/$(resource.data.reserved_offer_id)).data.buyer_id == resource.data.reserved_for_user_id)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes is number
            && resource.data.likes is number
            && (
              (request.resource.data.likes == resource.data.likes + 1
                && !exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + listingId))
                && existsAfter(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + listingId)))
              ||
              (request.resource.data.likes == resource.data.likes - 1
                && exists(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + listingId))
                && !existsAfter(/databases/$(database)/documents/likes/$(request.auth.uid + '_' + listingId)))
            )));
      
      // Only the seller can delete their listing
      allow delete: if isAuthenticated() 
                    && resource.data.seller_id == request.auth.uid
                    && resource.data.status != 'reserved';
      
      // Comments subcollection
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        
        // Only authenticated users can create comments
        allow create: if isAuthenticated() 
                      && request.resource.data.user_id == request.auth.uid
                      && request.resource.data.keys().hasAll(['user_id', 'user_name', 'comment', 'created_at']);
        
        // Allow updating reply_count field
        allow update: if isAuthenticated() 
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply_count']);
        
        // Comment author or listing owner can delete a comment.
        // Listing-owner access is needed for complete listing deletion.
        allow delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid)
                      || isListingOwner(listingId);
        
        // Replies subcollection
        match /replies/{replyId} {
          // Anyone can read replies
          allow read: if true;
          
          // Only authenticated users can create replies
          allow create: if isAuthenticated() 
                        && request.resource.data.user_id == request.auth.uid
                        && request.resource.data.keys().hasAll(['user_id', 'user_name', 'reply', 'created_at']);
          
          // Reply author or listing owner can delete a reply.
          allow delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid)
                        || isListingOwner(listingId);
          
          // No updates allowed on replies
          allow update: if false;
        }
      }
    }
    
    // Likes collection
    match /likes/{likeId} {
      // Anyone authenticated can read likes
      allow read: if isAuthenticated();
      
      // Likes use a deterministic user/listing identity.
      allow create: if isAuthenticated()
        && likeId == request.auth.uid + '_' + request.resource.data.listingId
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId));
      
      // Like owner can remove it; listing owner can remove it during listing cleanup.
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || isListingOwner(resource.data.listingId));
      
      // Likes cannot be updated
      allow update: if false;
    }
    
    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      // Anyone authenticated can read bookmarks (needed for checking bookmark status)
      allow read: if isAuthenticated();
      
      // Bookmarks use a deterministic user/listing identity.
      allow create: if isAuthenticated()
        && bookmarkId == request.auth.uid + '_' + request.resource.data.listingId
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId));
      
      // Bookmark owner can remove it; listing owner can remove it during cleanup.
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || isListingOwner(resource.data.listingId));
      
      // Bookmarks cannot be updated
      allow update: if false;
    }
    
    // Favorites collection
    match /favorites/{favoriteId} {
      // Anyone authenticated can read favorites (needed for checking favorite status and getting follower lists)
      allow read: if isAuthenticated();
      
      // Favorites are the app's follow-seller relationship.
      allow create: if isAuthenticated()
        && favoriteId == request.auth.uid + '_' + request.resource.data.seller_id
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.seller_id != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.seller_id));
      
      // The follower can remove the relationship. The seller may also remove
      // incoming relationships, which is required when deleting their account.
      allow delete: if isAuthenticated()
        && (resource.data.user_id == request.auth.uid
            || resource.data.seller_id == request.auth.uid);
      
      // Favorites cannot be updated
      allow update: if false;
    }
    
    // Blocks collection - NEW!
    match /blocks/{blockId} {
      // Users can read blocks where they are the blocker or the blocked user
      allow read: if isAuthenticated() && 
        (resource.data.blocker_id == request.auth.uid || 
         resource.data.blocked_id == request.auth.uid);
      
      // Users can only create blocks where they are the blocker
      // Block ID must follow the pattern: {blocker_uid}_{blocked_uid}
      allow create: if isAuthenticated()
        && request.resource.data.blocker_id == request.auth.uid
        && request.resource.data.blocked_id != request.auth.uid
        && request.resource.data.keys().hasOnly(['blocker_id', 'blocked_id', 'blocked_at'])
        && blockId == request.auth.uid + '_' + request.resource.data.blocked_id
        && exists(/databases/$(database)/documents/users/$(request.resource.data.blocked_id));
      
      // Users can only delete their own blocks (where they are the blocker)
      allow delete: if isAuthenticated() && 
        resource.data.blocker_id == request.auth.uid;
      
      // Blocks cannot be updated
      allow update: if false;
    }
    
    // Marketplace offers. The buyer creates an offer; the seller may accept,
    // decline, or counter it. A buyer may then accept or decline a counter.
    match /offers/{offerId} {
      allow read: if isAuthenticated()
        && (resource.data.buyer_id == request.auth.uid
            || resource.data.seller_id == request.auth.uid);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'listing_id', 'listing_title', 'listing_price', 'seller_id', 'buyer_id',
          'chat_id', 'initial_amount', 'amount', 'status', 'created_at',
          'updated_at', 'last_action_by'
        ])
        && request.resource.data.buyer_id == request.auth.uid
        && request.resource.data.seller_id != request.auth.uid
        && request.resource.data.initial_amount is number
        && request.resource.data.initial_amount > 0
        && request.resource.data.amount == request.resource.data.initial_amount
        && request.resource.data.status == 'pending'
        && request.resource.data.last_action_by == request.auth.uid
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listing_id))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.seller_id == request.resource.data.seller_id
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.status == 'active'
        && request.resource.data.listing_title == get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.title
        && request.resource.data.listing_price == get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.price
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chat_id))
        && request.resource.data.buyer_id in get(/databases/$(database)/documents/chats/$(request.resource.data.chat_id)).data.participants
        && request.resource.data.seller_id in get(/databases/$(database)/documents/chats/$(request.resource.data.chat_id)).data.participants;

      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount', 'status', 'updated_at', 'last_action_by'
        ])
        && request.resource.data.updated_at == request.time
        && request.resource.data.last_action_by == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && (request.resource.data.status in ['declined', 'cancelled']
          || (exists(/databases/$(database)/documents/listings/$(resource.data.listing_id))
            && get(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.status == 'active'))
        && (
          (request.auth.uid == resource.data.seller_id
            && resource.data.status == 'pending'
            && (
              (request.resource.data.status in ['accepted', 'declined']
                && request.resource.data.amount == resource.data.amount)
              || (request.resource.data.status == 'countered'
                && request.resource.data.amount != resource.data.amount)
            ))
          ||
          (request.auth.uid == resource.data.buyer_id
            && resource.data.status == 'countered'
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.amount == resource.data.amount)
          ||
          ((request.auth.uid == resource.data.seller_id
              || request.auth.uid == resource.data.buyer_id)
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.amount == resource.data.amount
            && get(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.status == 'reserved'
            && get(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.reserved_offer_id == offerId
            && (request.auth.uid == resource.data.seller_id
              || get(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.reserved_for_user_id == request.auth.uid)
            && getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.status == 'active'
            && !getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.keys().hasAny([
              'reserved_for_user_id', 'reserved_offer_id', 'reserved_at'
            ])
            && (!exists(/databases/$(database)/documents/transactions/$(offerId))
              || (existsAfter(/databases/$(database)/documents/transactions/$(offerId))
                && getAfter(/databases/$(database)/documents/transactions/$(offerId)).data.status == 'cancelled'
                && getAfter(/databases/$(database)/documents/transactions/$(offerId)).data.last_action_by == request.auth.uid)))
        )
        && (request.resource.data.status != 'accepted'
          || (getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.status == 'reserved'
            && getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.reserved_offer_id == offerId
            && getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.reserved_for_user_id == resource.data.buyer_id
            && existsAfter(/databases/$(database)/documents/transactions/$(offerId))
            && getAfter(/databases/$(database)/documents/transactions/$(offerId)).data.status == 'reserved'
            && getAfter(/databases/$(database)/documents/transactions/$(offerId)).data.offer_id == offerId
            && getAfter(/databases/$(database)/documents/transactions/$(offerId)).data.listing_id == resource.data.listing_id
            && getAfter(/databases/$(database)/documents/transactions/$(offerId)).data.seller_id == resource.data.seller_id
            && getAfter(/databases/$(database)/documents/transactions/$(offerId)).data.buyer_id == resource.data.buyer_id));

      allow delete: if isAuthenticated()
        && (resource.data.buyer_id == request.auth.uid
            || resource.data.seller_id == request.auth.uid)
        && (resource.data.status != 'accepted'
          || (exists(/databases/$(database)/documents/transactions/$(offerId))
            && get(/databases/$(database)/documents/transactions/$(offerId)).data.status == 'completed'));
    }

    // Completed marketplace exchanges. The transaction ID is the accepted
    // offer ID, so one reservation can only produce one transaction record.
    match /transactions/{transactionId} {
      allow read: if isAuthenticated()
        && (resource.data.buyer_id == request.auth.uid
            || resource.data.seller_id == request.auth.uid);

      // New acceptances create an unconfirmed transaction. Reservations that
      // predate this collection may also be backfilled by one participant when
      // they record their own first completion confirmation.
      allow create: if isAuthenticated()
        && transactionId == request.resource.data.offer_id
        && request.resource.data.keys().hasAll([
          'offer_id', 'listing_id', 'listing_title', 'seller_id', 'buyer_id',
          'chat_id', 'agreed_price', 'status', 'buyer_confirmed',
          'seller_confirmed', 'created_at', 'updated_at', 'last_action_by'
        ])
        && request.resource.data.keys().hasOnly([
          'offer_id', 'listing_id', 'listing_title', 'seller_id', 'buyer_id',
          'chat_id', 'agreed_price', 'status', 'buyer_confirmed',
          'seller_confirmed', 'buyer_confirmed_at', 'seller_confirmed_at',
          'created_at', 'updated_at', 'last_action_by'
        ])
        && request.resource.data.seller_id is string
        && request.resource.data.buyer_id is string
        && request.resource.data.seller_id != request.resource.data.buyer_id
        && request.auth.uid in [
          request.resource.data.seller_id,
          request.resource.data.buyer_id
        ]
        && request.resource.data.listing_title is string
        && request.resource.data.agreed_price is number
        && request.resource.data.agreed_price > 0
        && request.resource.data.status == 'reserved'
        && request.resource.data.buyer_confirmed is bool
        && request.resource.data.seller_confirmed is bool
        && !(request.resource.data.buyer_confirmed
          && request.resource.data.seller_confirmed)
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time
        && request.resource.data.last_action_by == request.auth.uid
        && ((request.resource.data.buyer_confirmed == false
              && !request.resource.data.keys().hasAny(['buyer_confirmed_at']))
            || (request.resource.data.buyer_confirmed == true
              && request.auth.uid == request.resource.data.buyer_id
              && request.resource.data.buyer_confirmed_at == request.time))
        && ((request.resource.data.seller_confirmed == false
              && !request.resource.data.keys().hasAny(['seller_confirmed_at']))
            || (request.resource.data.seller_confirmed == true
              && request.auth.uid == request.resource.data.seller_id
              && request.resource.data.seller_confirmed_at == request.time))
        && existsAfter(/databases/$(database)/documents/offers/$(transactionId))
        && getAfter(/databases/$(database)/documents/offers/$(transactionId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/offers/$(transactionId)).data.listing_id == request.resource.data.listing_id
        && getAfter(/databases/$(database)/documents/offers/$(transactionId)).data.seller_id == request.resource.data.seller_id
        && getAfter(/databases/$(database)/documents/offers/$(transactionId)).data.buyer_id == request.resource.data.buyer_id
        && getAfter(/databases/$(database)/documents/offers/$(transactionId)).data.chat_id == request.resource.data.chat_id
        && getAfter(/databases/$(database)/documents/offers/$(transactionId)).data.amount == request.resource.data.agreed_price
        && getAfter(/databases/$(database)/documents/offers/$(transactionId)).data.listing_title == request.resource.data.listing_title
        && existsAfter(/databases/$(database)/documents/listings/$(request.resource.data.listing_id))
        && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.status == 'reserved'
        && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.reserved_offer_id == transactionId
        && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.reserved_for_user_id == request.resource.data.buyer_id
        && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.seller_id == request.resource.data.seller_id;

      allow update: if isAuthenticated()
        && resource.data.status == 'reserved'
        && request.auth.uid in [resource.data.seller_id, resource.data.buyer_id]
        && request.resource.data.keys().hasOnly([
          'offer_id', 'listing_id', 'listing_title', 'seller_id', 'buyer_id',
          'chat_id', 'agreed_price', 'status', 'buyer_confirmed',
          'seller_confirmed', 'buyer_confirmed_at', 'seller_confirmed_at',
          'created_at', 'updated_at', 'last_action_by', 'completed_at',
          'cancelled_at'
        ])
        && request.resource.data.offer_id == resource.data.offer_id
        && request.resource.data.listing_id == resource.data.listing_id
        && request.resource.data.listing_title == resource.data.listing_title
        && request.resource.data.seller_id == resource.data.seller_id
        && request.resource.data.buyer_id == resource.data.buyer_id
        && request.resource.data.chat_id == resource.data.chat_id
        && request.resource.data.agreed_price == resource.data.agreed_price
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at == request.time
        && request.resource.data.last_action_by == request.auth.uid
        && (
          (
            (
              (request.auth.uid == resource.data.buyer_id
                && resource.data.buyer_confirmed == false
                && request.resource.data.buyer_confirmed == true
                && request.resource.data.seller_confirmed == resource.data.seller_confirmed
                && request.resource.data.buyer_confirmed_at == request.time
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'buyer_confirmed', 'buyer_confirmed_at', 'status',
                  'updated_at', 'last_action_by', 'completed_at'
                ]))
              ||
              (request.auth.uid == resource.data.seller_id
                && resource.data.seller_confirmed == false
                && request.resource.data.seller_confirmed == true
                && request.resource.data.buyer_confirmed == resource.data.buyer_confirmed
                && request.resource.data.seller_confirmed_at == request.time
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'seller_confirmed', 'seller_confirmed_at', 'status',
                  'updated_at', 'last_action_by', 'completed_at'
                ]))
            )
            && (
              (request.resource.data.buyer_confirmed == true
                && request.resource.data.seller_confirmed == true
                && request.resource.data.status == 'completed'
                && request.resource.data.completed_at == request.time
                && !request.resource.data.keys().hasAny(['cancelled_at'])
                && existsAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id))
                && getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.status == 'sold'
                && getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.sold_transaction_id == transactionId
                && getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.sold_at == request.time
                && !getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.keys().hasAny([
                  'reserved_for_user_id', 'reserved_offer_id', 'reserved_at'
                ]))
              ||
              (!(request.resource.data.buyer_confirmed == true
                  && request.resource.data.seller_confirmed == true)
                && request.resource.data.status == 'reserved'
                && !request.resource.data.keys().hasAny([
                  'completed_at', 'cancelled_at'
                ]))
            )
          )
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancelled_at', 'updated_at', 'last_action_by'
            ])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelled_at == request.time
            && !request.resource.data.keys().hasAny(['completed_at'])
            && existsAfter(/databases/$(database)/documents/offers/$(resource.data.offer_id))
            && getAfter(/databases/$(database)/documents/offers/$(resource.data.offer_id)).data.status == 'cancelled'
            && getAfter(/databases/$(database)/documents/offers/$(resource.data.offer_id)).data.last_action_by == request.auth.uid
            && existsAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id))
            && getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.status == 'active'
            && !getAfter(/databases/$(database)/documents/listings/$(resource.data.listing_id)).data.keys().hasAny([
              'reserved_for_user_id', 'reserved_offer_id', 'reserved_at'
            ]))
        );

      // A shared transaction record is immutable once completed/cancelled and
      // cannot be erased unilaterally by either participant.
      allow delete: if false;
    }

    // Chats collection
    match /chats/{chatId} {
      // Only chat participants can read/write
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // A chat is one two-person conversation with a deterministic pair ID.
      allow create: if isAuthenticated()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
        && (chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
            || chatId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);
      
      // Participants may only update conversation metadata.
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageTime', 'deletedFor', 'deletedForTimestamps'
        ]);
      
      // Only participants can delete the entire chat
      allow delete: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read messages
        allow read: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Chat messages use a strict schema. Structured offer messages must
        // correspond to the offer state written in the same atomic operation.
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.timestamp == request.time
          && request.resource.data.read == false
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly([
                'senderId', 'text', 'timestamp', 'read', 'type'
              ])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000)
            ||
            (request.resource.data.type == 'image'
              && request.resource.data.keys().hasOnly([
                'senderId', 'imageUrl', 'timestamp', 'read', 'type'
              ])
              && request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() > 0)
            ||
            (request.resource.data.type == 'offer'
              && request.resource.data.keys().hasOnly([
                'senderId', 'offerId', 'listingId', 'timestamp', 'read', 'type'
              ])
              && request.resource.data.offerId is string
              && request.resource.data.listingId is string
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.buyer_id == request.auth.uid
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.chat_id == chatId
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.listing_id == request.resource.data.listingId
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.status == 'pending'
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.created_at == request.time
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.last_action_by == request.auth.uid)
            ||
            (request.resource.data.type == 'offer_update'
              && request.resource.data.keys().hasOnly([
                'senderId', 'offerId', 'listingId', 'offerStatus', 'amount',
                'timestamp', 'read', 'type'
              ])
              && request.resource.data.offerId is string
              && request.resource.data.listingId is string
              && request.resource.data.offerStatus in [
                'countered', 'accepted', 'declined', 'cancelled'
              ]
              && request.resource.data.amount is number
              && request.resource.data.amount > 0
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.chat_id == chatId
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.listing_id == request.resource.data.listingId
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.status == request.resource.data.offerStatus
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.amount == request.resource.data.amount
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.last_action_by == request.auth.uid
              && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.offerId)).data.updated_at == request.time)
            ||
            (request.resource.data.type == 'transaction_update'
              && request.resource.data.keys().hasOnly([
                'senderId', 'transactionId', 'listingId', 'transactionStatus',
                'confirmedRole', 'timestamp', 'read', 'type'
              ])
              && request.resource.data.transactionId is string
              && request.resource.data.listingId is string
              && request.resource.data.transactionStatus in ['reserved', 'completed']
              && request.resource.data.confirmedRole in ['buyer', 'seller']
              && existsAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId))
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.chat_id == chatId
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.listing_id == request.resource.data.listingId
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.status == request.resource.data.transactionStatus
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.last_action_by == request.auth.uid
              && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.updated_at == request.time
              && ((request.resource.data.confirmedRole == 'buyer'
                    && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.buyer_id == request.auth.uid
                    && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.buyer_confirmed == true)
                  || (request.resource.data.confirmedRole == 'seller'
                    && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.seller_id == request.auth.uid
                    && getAfter(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.seller_confirmed == true)))
          );
        
        // Users may remove their ordinary chat messages, but structured offer
        // history remains available to both participants.
        allow delete: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && resource.data.senderId == request.auth.uid
          && resource.data.type in ['text', 'image'];
        
        // Allow participants to update read status
        allow update: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }
    
    // Unique authenticated listing views.
    match /listing_views/{viewId} {
      allow read: if isAuthenticated()
        && (resource.data.viewer_id == request.auth.uid
            || isListingOwner(resource.data.listing_id));

      allow create: if isAuthenticated()
        && viewId == request.auth.uid + '_' + request.resource.data.listing_id
        && request.resource.data.keys().hasOnly(['listing_id', 'viewer_id', 'viewed_at'])
        && request.resource.data.viewer_id == request.auth.uid
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listing_id))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.seller_id
          != request.auth.uid;

      allow update: if false;
      allow delete: if isAuthenticated()
        && (resource.data.viewer_id == request.auth.uid
            || isListingOwner(resource.data.listing_id));
    }

    // Listing shares tracking collection
    match /listing_shares/{shareId} {
      // Anyone authenticated can read shares
      allow read: if isAuthenticated();
      
      // Authenticated users can create share records for existing listings.
      allow create: if isAuthenticated()
        && request.resource.data.shared_by == request.auth.uid
        && request.resource.data.keys().hasOnly(['listing_id', 'shared_by', 'shared_at'])
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listing_id));
      
      allow update: if false;

      // Sharer can remove their record; listing owner can remove it during cleanup.
      allow delete: if isAuthenticated()
        && (resource.data.shared_by == request.auth.uid
            || isListingOwner(resource.data.listing_id));
    }
    
    // Listing reports are immutable client submissions. Moderation status is
    // updated only by trusted backend/Admin SDK processes.
    match /listing_reports/{reportId} {
      allow read: if isAuthenticated()
        && resource.data.reported_by == request.auth.uid;

      allow create: if isAuthenticated()
        && reportId == request.auth.uid + '_' + request.resource.data.listing_id
        && request.resource.data.keys().hasOnly([
          'listing_id', 'listing_owner_id', 'reported_by', 'reason', 'details',
          'status', 'created_at', 'updated_at'
        ])
        && request.resource.data.reported_by == request.auth.uid
        && request.resource.data.listing_owner_id != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason in [
          'spam', 'prohibited_item', 'misleading', 'scam', 'harassment', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && exists(/databases/$(database)/documents/listings/$(request.resource.data.listing_id))
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.seller_id
          == request.resource.data.listing_owner_id;

      allow update, delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() 
        && request.auth.uid == resource.data.recipient_id;
      
      // Notifications must match the canonical schema and a real source action.
      allow create: if isAuthenticated()
        && isCanonicalNotification()
        && hasValidNotificationSource();
      
      // Recipients may only change read state.
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.recipient_id
        && request.resource.data.recipient_id == resource.data.recipient_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
      
      // Recipient, authenticated sender, or listing owner may clean a notification.
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.recipient_id
            || request.auth.uid == resource.data.sender_id
            || (resource.data.related_listing_id is string
                && isListingOwner(resource.data.related_listing_id)));
    }
  }
}