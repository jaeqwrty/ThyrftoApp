rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidListing() {
      return request.resource.data.keys().hasAll(['title', 'price', 'seller_id']) 
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for seller info display and username checks)
      allow read: if true;
      
      // Users can only manage their own profile
      // DEV BYPASS: Allow a@test.com to manage all users for reset/seeding
      // RATING UPDATE: Allow authenticated users to update average_rating and ratings_count
      allow create, delete: if isOwner(userId) || request.auth.token.email == "a@test.com";
      
      allow update: if isOwner(userId) 
                    || request.auth.token.email == "a@test.com"
                    // Allow any authenticated user to update rating stats
                    || (isAuthenticated() && 
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['average_rating', 'ratings_count']));
      
      // Ratings subcollection (nested under users)
      match /ratings/{ratingId} {
        // Anyone can read ratings
        allow read: if true;
        
        // Authenticated users can create ratings for other users
        allow create: if isAuthenticated() 
          && request.resource.data.reviewer_id == request.auth.uid
          && request.auth.uid != userId; // Can't rate yourself
        
        // Only rating creator can update their own rating
        allow update: if isAuthenticated() 
          && resource.data.reviewer_id == request.auth.uid;
        
        // Only rating creator can delete their own rating
        allow delete: if isAuthenticated() 
          && resource.data.reviewer_id == request.auth.uid;
      }
    }
    
    // Followers collection
    match /followers/{followId} {
      // Anyone authenticated can read followers
      allow read: if isAuthenticated();
      
      // Users can only create follow relationships where they are the follower
      allow create: if isAuthenticated() 
        && request.resource.data.follower_id == request.auth.uid;
      
      // Users can only delete their own follow relationships
      allow delete: if isAuthenticated() 
        && resource.data.follower_id == request.auth.uid;
      
      // Follow relationships cannot be updated
      allow update: if false;
    }
    
    // Listings collection
    match /listings/{listingId} {
      allow read: if true;
      
      // Users can create listings
      allow create: if isAuthenticated() 
                    && isValidListing()
                    && request.resource.data.seller_id == request.auth.uid;
      
      // Seller can update their listing, OR anyone can update likes/like_count
      allow update: if isAuthenticated() 
                    && (resource.data.seller_id == request.auth.uid 
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'like_count']));
      
      // Only the seller can delete their listing
      allow delete: if isAuthenticated() 
                    && resource.data.seller_id == request.auth.uid;
      
      // Comments subcollection
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        
        // Only authenticated users can create comments
        allow create: if isAuthenticated() 
                      && request.resource.data.user_id == request.auth.uid
                      && request.resource.data.keys().hasAll(['user_id', 'user_name', 'comment', 'created_at']);
        
        // Allow updating reply_count field
        allow update: if isAuthenticated() 
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply_count']);
        
        // Only the comment author can delete their comment
        // DEV BYPASS: Allow a@test.com to delete any comment
        allow delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid)
                      || request.auth.token.email == "a@test.com";
        
        // Replies subcollection
        match /replies/{replyId} {
          // Anyone can read replies
          allow read: if true;
          
          // Only authenticated users can create replies
          allow create: if isAuthenticated() 
                        && request.resource.data.user_id == request.auth.uid
                        && request.resource.data.keys().hasAll(['user_id', 'user_name', 'reply', 'created_at']);
          
          // Only the reply author can delete their reply
          // DEV BYPASS: Allow a@test.com to delete any reply
          allow delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid)
                        || request.auth.token.email == "a@test.com";
          
          // No updates allowed on replies
          allow update: if false;
        }
      }
    }
    
    // Likes collection
    match /likes/{likeId} {
      // Anyone authenticated can read likes
      allow read: if isAuthenticated();
      
      // Users can only create likes for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Users can only delete their own likes
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Likes cannot be updated
      allow update: if false;
    }
    
    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      // Anyone authenticated can read bookmarks (needed for checking bookmark status)
      allow read: if isAuthenticated();
      
      // Users can only create bookmarks for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Users can only delete their own bookmarks
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Bookmarks cannot be updated
      allow update: if false;
    }
    
    // Favorites collection
    match /favorites/{favoriteId} {
      // Anyone authenticated can read favorites (needed for checking favorite status and getting follower lists)
      allow read: if isAuthenticated();
      
      // Users can only create favorites for themselves
      allow create: if isAuthenticated() 
        && request.resource.data.user_id == request.auth.uid;
      
      // Users can only delete their own favorites
      allow delete: if isAuthenticated() 
        && resource.data.user_id == request.auth.uid;
      
      // Favorites cannot be updated
      allow update: if false;
    }
    
    // Blocks collection - NEW!
    match /blocks/{blockId} {
      // Users can read blocks where they are the blocker or the blocked user
      allow read: if isAuthenticated() && 
        (resource.data.blocker_id == request.auth.uid || 
         resource.data.blocked_id == request.auth.uid);
      
      // Users can only create blocks where they are the blocker
      // Block ID must follow the pattern: {blocker_uid}_{blocked_uid}
      allow create: if isAuthenticated() && 
        request.resource.data.blocker_id == request.auth.uid &&
        request.resource.data.keys().hasAll(['blocker_id', 'blocked_id', 'blocked_at']) &&
        blockId == request.auth.uid + '_' + request.resource.data.blocked_id;
      
      // Users can only delete their own blocks (where they are the blocker)
      allow delete: if isAuthenticated() && 
        resource.data.blocker_id == request.auth.uid;
      
      // Blocks cannot be updated
      allow update: if false;
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Only chat participants can read/write
      allow read: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Authenticated users can create chats if they are participants
      allow create: if isAuthenticated() 
        && request.auth.uid in request.resource.data.participants;
      
      // Only participants can update chat (for lastMessage updates and deletedFor array)
      allow update: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Only participants can delete the entire chat
      allow delete: if isAuthenticated() 
        && request.auth.uid in resource.data.participants;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only chat participants can read messages
        allow read: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        // Only chat participants can send messages
        allow create: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        
        // Only the message sender can delete their own messages
        allow delete: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && resource.data.senderId == request.auth.uid;
        
        // Allow participants to update read status
        allow update: if isAuthenticated() 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }
    
    // Listing shares tracking collection
    match /listing_shares/{shareId} {
      // Anyone authenticated can read shares
      allow read: if isAuthenticated();
      
      // Authenticated users can create share records
      allow create: if isAuthenticated() 
        && request.resource.data.shared_by == request.auth.uid;
      
      // No updates or deletes
      allow update, delete: if false;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() 
        && request.auth.uid == resource.data.recipient_id;
      
      // Authenticated users can create notifications (for sending to others)
      allow create: if isAuthenticated();
      
      // Users can only update their own notifications (mark as read)
      allow update: if isAuthenticated() 
        && request.auth.uid == resource.data.recipient_id;
      
      // Users can only delete their own notifications
      allow delete: if isAuthenticated() 
        && request.auth.uid == resource.data.recipient_id;
    }
  }
}